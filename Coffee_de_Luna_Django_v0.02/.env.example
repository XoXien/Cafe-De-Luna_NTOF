# Set these as real environment variables; this file is a reference, not auto-loaded.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# Use only behind an HTTPS-enabled server. Local demo defaults do not need these.
DJANGO_SSL_REDIRECT=1
